{
  "private": true,
  "name": "squoosh",
  "version": "2.0.0",
  "license": "apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "rollup -c && bun lib/move-output.js",
    "debug": "bun --inspect-brk node_modules/rollup/dist/bin/rollup -c",
    "dev": "bun lib/dev.js",
    "watch": "rollup -cw",
    "serve": "serve --config ../../../serve.json .tmp/build/static",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@surma/rollup-plugin-off-main-thread": "^2.2.3",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.6",
    "@web/rollup-plugin-import-meta-assets": "^3.0.0",
    "comlink": "^4.4.2",
    "cssnano": "^9.9.0",
    "dedent": "^1.7.2",
    "file-drop-element": "^1.0.1",
    "glob": "^14.0.3",
    "husky": "^9.1.7",
    "idb-keyval": "^6.3.0",
    "image-size": "^2.0.4",
    "linkstate": "^2.0.1",
    "lint-staged": "^17.6.0",
    "lodash.camelcase": "^4.3.0",
    "mime-types": "^3.0.2",
    "pointer-tracker": "^2.5.3",
    "postcss": "^8.5.32",
    "postcss-modules": "^9.0.1",
    "postcss-nested": "^9.0.1",
    "postcss-simple-vars": "^7.0.1",
    "postcss-url": "^10.1.4",
    "preact": "^10",
    "preact-render-to-string": "^6.8.2",
    "prettier": "^3.9.10",
    "rollup": "^4",
    "serve": "^14.2.6",
    "typescript": "^6.0.3",
    "wasm-feature-detect": "^1.9.0"
  },
  "lint-staged": {
    "*.{js,css,json,md,ts,tsx}": "prettier --write",
    "*.{c,h,cpp,hpp}": "clang-format -i",
    "*.rs": "rustfmt"
  }
}
