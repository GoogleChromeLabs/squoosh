{
  "private": true,
  "name": "squoosh",
  "version": "2.0.0",
  "license": "apache-2.0",
  "scripts": {
    "build": "rollup -c && node lib/move-output.js",
    "debug": "node --inspect-brk node_modules/.bin/rollup -c",
    "dev": "DEV_PORT=\"${DEV_PORT:=5000}\" run-p watch serve",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "watch": "rollup -cw",
    "serve": "serve --listen=$DEV_PORT --config ../../../serve.json .tmp/build/static",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.2",
    "@rollup/plugin-commonjs": "^21.1.0",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@rollup/plugin-replace": "^4.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@surma/rollup-plugin-off-main-thread": "^2.2.3",
    "@testing-library/preact": "^3.2.4",
    "@types/dedent": "^0.7.2",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.10.5",
    "@vitest/ui": "^2.1.8",
    "@web/rollup-plugin-import-meta-assets": "^1.0.7",
    "comlink": "^4.4.2",
    "cssnano": "^7.0.7",
    "dedent": "^0.7.0",
    "del": "^6.1.1",
    "file-drop-element": "^1.0.1",
    "happy-dom": "^15.11.7",
    "husky": "^9.1.7",
    "idb-keyval": "^6.2.1",
    "image-size": "^2.0.2",
    "linkstate": "^2.0.0",
    "lint-staged": "^15.2.11",
    "lodash.camelcase": "^4.3.0",
    "mime-types": "^2.1.35",
    "npm-run-all": "^4.1.5",
    "pointer-tracker": "^2.5.3",
    "postcss": "^8.4.49",
    "postcss-modules": "^6.0.1",
    "postcss-nested": "^7.0.2",
    "postcss-simple-vars": "^7.0.1",
    "postcss-url": "^10.1.3",
    "preact": "^10.5.15",
    "preact-render-to-string": "^5.2.6",
    "prettier": "^3.4.2",
    "rollup": "^2.79.2",
    "serve": "^14.2.4",
    "typescript": "^5.3.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wasm-feature-detect": "^1.8.0",
    "which": "^6.0.0"
  },
  "lint-staged": {
    "*.{js,css,json,md,ts,tsx}": "prettier --write",
    "*.{c,h,cpp,hpp}": "clang-format -i",
    "*.rs": "rustfmt"
  }
}
