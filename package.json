{
  "private": true,
  "name": "squoosh",
  "version": "2.0.0",
  "license": "apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6",
    "@vue/tsconfig": "^0.9.1",
    "comlink": "^4.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8",
    "vite-plugin-pwa": "^2",
    "vue": "^3.5",
    "vue-tsc": "^3",
    "wasm-feature-detect": "^1.9.0",
    "workbox-precaching": "^7",
    "workbox-routing": "^7",
    "workbox-strategies": "^7",
    "workbox-window": "^7"
  },
  "lint-staged": {
    "*.{js,css,json,md,ts,vue}": "prettier --write",
    "*.{c,h,cpp,hpp}": "clang-format -i",
    "*.rs": "rustfmt"
  }
}
