diff --git a/av1/encoder/pickrst.c b/av1/encoder/pickrst.c
index cd79ed9..4907ccf 100644
--- a/av1/encoder/pickrst.c
+++ b/av1/encoder/pickrst.c
@@ -2037,7 +2037,64 @@ static void set_restoration_unit_size(AV1_COMMON *cm, RestorationInfo *rsi,
   rsi->vert_units = vert_units;
 }
 
+static int squoosh_lr_blur_tap1 = 0;
+static int squoosh_lr_blur_tap2 = 0;
+
+void av1_squoosh_set_lr_blur(int tap1, int tap2) {
+  squoosh_lr_blur_tap1 =
+      clamp(tap1, WIENER_FILT_TAP1_MINV, WIENER_FILT_TAP1_MAXV);
+  squoosh_lr_blur_tap2 =
+      clamp(tap2, WIENER_FILT_TAP2_MINV, WIENER_FILT_TAP2_MAXV);
+}
+
+int av1_squoosh_lr_blur_active(void) {
+  return squoosh_lr_blur_tap1 != 0 || squoosh_lr_blur_tap2 != 0;
+}
+
+static void squoosh_set_blur_taps(InterpKernel f) {
+  f[0] = f[WIENER_WIN - 1] = 0;
+  f[1] = f[WIENER_WIN - 2] = (int16_t)squoosh_lr_blur_tap1;
+  f[2] = f[WIENER_WIN - 3] = (int16_t)squoosh_lr_blur_tap2;
+  // The centre tap has an implicit +WIENER_FILT_STEP (128), so this makes the
+  // taps sum to 1.
+  f[3] = (int16_t)(-2 * (squoosh_lr_blur_tap1 + squoosh_lr_blur_tap2));
+  f[WIENER_WIN] = 0;
+}
+
+// Applies the forced blur: one Wiener filter per plane, using the largest
+// unit size so the taps are signalled as few times as possible.
+static void squoosh_apply_lr_blur(AV1_COMMON *cm) {
+  const int num_planes = av1_num_planes(cm);
+  for (int plane = 0; plane < num_planes; ++plane) {
+    RestorationInfo *rsi = &cm->rst_info[plane];
+    const int is_uv = plane > 0;
+    int plane_w, plane_h;
+    av1_get_upsampled_plane_size(cm, is_uv, &plane_w, &plane_h);
+    const int num_units =
+        av1_lr_count_units(RESTORATION_UNITSIZE_MAX, plane_w) *
+        av1_lr_count_units(RESTORATION_UNITSIZE_MAX, plane_h);
+    aom_free(rsi->unit_info);
+    CHECK_MEM_ERROR(cm, rsi->unit_info,
+                    (RestorationUnitInfo *)aom_memalign(
+                        16, sizeof(*rsi->unit_info) * num_units));
+    memset(rsi->unit_info, 0, sizeof(*rsi->unit_info) * num_units);
+    set_restoration_unit_size(cm, rsi, is_uv, RESTORATION_UNITSIZE_MAX);
+    rsi->frame_restoration_type = RESTORE_WIENER;
+    for (int u = 0; u < rsi->num_rest_units; ++u) {
+      RestorationUnitInfo *rui = &rsi->unit_info[u];
+      rui->restoration_type = RESTORE_WIENER;
+      squoosh_set_blur_taps(rui->wiener_info.vfilter);
+      squoosh_set_blur_taps(rui->wiener_info.hfilter);
+    }
+  }
+}
+
 void av1_pick_filter_restoration(const YV12_BUFFER_CONFIG *src, AV1_COMP *cpi) {
+  if (av1_squoosh_lr_blur_active()) {
+    squoosh_apply_lr_blur(&cpi->common);
+    return;
+  }
+
   AV1_COMMON *const cm = &cpi->common;
   MACROBLOCK *const x = &cpi->td.mb;
   const SequenceHeader *const seq_params = cm->seq_params;
diff --git a/av1/encoder/pickrst.h b/av1/encoder/pickrst.h
index 22bb000..b00ffbd 100644
--- a/av1/encoder/pickrst.h
+++ b/av1/encoder/pickrst.h
@@ -119,6 +119,16 @@ static inline uint16_t find_average_highbd(const uint16_t *src, int h_start,
  */
 void av1_pick_filter_restoration(const YV12_BUFFER_CONFIG *sd, AV1_COMP *cpi);
 
+// Squoosh: while set, av1_pick_filter_restoration() skips its search and
+// applies a fixed, symmetric low-pass Wiener filter to every plane instead,
+// turning loop restoration into a decoder-side blur. tap1 and tap2 are the
+// two outer taps (in 1/128ths) either side of the implied centre tap; the
+// outermost 7-tap coefficient is left at 0 so the same kernel is valid for
+// chroma. Pass 0, 0 to go back to normal restoration. This is process-global
+// state, so it's only safe while one encoder is encoding frames at a time.
+void av1_squoosh_set_lr_blur(int tap1, int tap2);
+int av1_squoosh_lr_blur_active(void);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
