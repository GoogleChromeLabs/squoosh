{
  "compilerOptions": {
    "target": "ES2019",
    "module": "esnext",
    "jsx": "react",
    "jsxFactory": "h",
    "strict": true,
    "moduleResolution": "bundler",
    "composite": true,
    "declarationMap": true,
    "rootDir": "./",
    "outDir": ".tmp/ts",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "paths": {
      "static-build/*": ["./src/static-build/*"],
      "client/*": ["./src/client/*"],
      "shared/*": ["./src/shared/*"],
      "features/*": ["./src/features/*"],
      "worker-shared/*": ["./src/worker-shared/*"],
      "codecs/*": ["./codecs/*"],
      // These packages ship types that their "exports" maps don't expose.
      "linkstate": ["./node_modules/linkstate/src/index.d.ts"],
      "pointer-tracker": ["./node_modules/pointer-tracker/dist/index.d.ts"]
    }
  }
}
