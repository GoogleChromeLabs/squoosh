{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite-dev",
      "runtimeExecutable": "bunx",
      "runtimeArgs": ["vite"],
      "port": 5000
    },
    {
      "name": "squoosh-dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev"],
      "port": 5000
    },
    {
      "name": "squoosh-build",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "x",
        "serve",
        "--config",
        "../serve.json",
        "--listen",
        "5050",
        "build"
      ],
      "port": 5050,
      "autoPort": false
    }
  ]
}
